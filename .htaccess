<IfModule mod_rewrite.c>
    RewriteEngine On

    # Rediriger toutes les requêtes vers le dossier public/
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Sécurité : bloquer l'accès aux dossiers sensibles
<FilesMatch "\.(env|sql|log)$">
    Require all denied
</FilesMatch>
